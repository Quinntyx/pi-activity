{
  "name": "pi-activity",
  "version": "1.0.0",
  "description": "Model-tagged activity labels and live activity tracking for pi: the `activity` tool parameter, a what-is-the-agent-doing API with session stats, the label shimmer painter, and a footer status line",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "activity",
    "activity-labels",
    "tool-labels",
    "shimmer",
    "status-line"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://git.quinntyx.dev/quinntyx/pi-activity.git"
  },
  "files": [
    "API.md",
    "MIGRATION.md",
    "extensions/index.ts",
    "extensions/bash-command.ts",
    "config/config.example.json",
    "README.md"
  ],
  "scripts": {
    "test": "node --test scripts/activity.test.mjs",
    "typecheck": "tsc --noEmit --target ES2022 --module NodeNext --moduleResolution NodeNext --skipLibCheck extensions/index.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "@sinclair/typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.79.1",
    "@earendil-works/pi-tui": "^0.79.1",
    "@sinclair/typebox": "^0.34.49",
    "@types/node": "^25.7.0",
    "typescript": "^6.0.3"
  },
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ]
  }
}
